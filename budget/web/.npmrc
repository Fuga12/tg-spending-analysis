# Публичный реестр явно, а не по настройке машины.
#
# Lock-файл запоминает, откуда скачан каждый пакет. Собранный за корпоративным
# зеркалом, он ссылается на адреса, которых снаружи не существует, и сборка
# падает по таймауту у всех, кроме автора. Один раз это уже случилось.
registry=https://registry.npmjs.org/
