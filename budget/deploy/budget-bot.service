[Unit]
Description=Telegram-бот учёта совместного бюджета
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=budget
Group=budget
WorkingDirectory=/opt/budget
EnvironmentFile=/opt/budget/.env
ExecStart=/opt/budget/bot
Restart=always
RestartSec=5

# Остановка последовательная: веб (10 с) → обработчики бота (45 с) → воркер
# добора (45 с). Дефолтные 90 с systemd в этот бюджет не укладываются, а
# SIGKILL посреди разбора означает потерянную трату (plan.md §8).
TimeoutStopSec=120

# Бот ходит только в Telegram, Yandex AI Studio и локальный Postgres —
# больше ему ничего не нужно.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/budget

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
