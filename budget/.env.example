BOT_TOKEN=
# В докере хост — имя сервиса compose и порт 5432 внутри сети:
#   postgres://budget:пароль@postgres:5432/budget?sslmode=disable
# Без докера — localhost и порт, на котором стоит база.
DATABASE_URL=postgres://budget:пароль@localhost:5432/budget?sslmode=disable
# Пароль базы для docker compose: им поднимается сам postgres. Должен
# совпадать с тем, что в DATABASE_URL.
POSTGRES_PASSWORD=
# Кого пускать в бота. Пусто — бот открыт для всех: кто с кем ведёт бюджет,
# решает состав группы, а не эта настройка.
ALLOWED_USER_IDS=111111111,222222222
# Кому уходят служебные уведомления: потолок токенов, пропавшие бэкапы.
# Отдельно от списка: при открытом боте список пуст, и владельца в нём нет.
OWNER_ID=111111111
TZ=Europe/Moscow
REMINDER_AT=21:00

# Адрес Mini App. Пусто — приложения ещё нет: бот не показывает ни кнопку
# под приветствием, ни кнопку меню. Telegram открывает Mini App только
# по https, другую схему бот не примет.
APP_URL=
# Где слушает сервер приложения. Пусто — сервер не поднимается.
# В докере обязательно 0.0.0.0:8081: на 127.0.0.1 приложение слушает петлю
# самого контейнера, и проброшенный порт до него не достаёт. Наружу его всё
# равно не видно — compose публикует порт только на loopback машины.
APP_LISTEN=127.0.0.1:8081
# ТОЛЬКО ДЛЯ РАЗРАБОТКИ: пускает в приложение без подписи Telegram от имени
# этого человека. В проде переменной быть не должно — она снимает
# единственную проверку, которая вообще есть. При старте бот об этом кричит.
APP_DEV_USER_ID=

# Каталог с дампами. Задан — бот следит, что бэкапы свежие, и пишет владельцу,
# если перестали появляться. Пусто — слежения нет.
BACKUP_DIR=/var/backups/budget
BACKUP_MAX_AGE=36h

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=yandexgpt/rc
LLM_TIMEOUT=6s
LLM_MONTHLY_TOKEN_BUDGET=2000000
LLM_PRICE_PER_1K_RUB=1.0
LLM_BREAKER_COOLDOWN=30m
# Месячный потолок токенов на одну группу. 0 выключает: пока бот закрыт,
# считать по группам незачем. При открытом — обязателен, иначе первая же
# активная группа выбирает грант целиком.
LLM_GROUP_TOKEN_BUDGET=200000
# Сколько сообщений в сутки бот разбирает от одного человека. 0 выключает.
MESSAGES_PER_DAY=200
